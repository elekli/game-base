# Copy to .env.local and replace every fixture with the binding for this environment.
VERCEL_ENV=development
EXPECTED_VERCEL_ENV=development

SUPABASE_PROJECT_REF=local
EXPECTED_SUPABASE_PROJECT_REF=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
EXPECTED_SUPABASE_PUBLISHABLE_KEY_SHA256=replace_with_64_lowercase_hex_characters
EXPECTED_SUPABASE_SECRET_KEY_SHA256=replace_with_64_lowercase_hex_characters

SUPAVISOR_HOST=127.0.0.1
EXPECTED_SUPAVISOR_HOST=127.0.0.1
SUPAVISOR_PORT=54329
SUPAVISOR_USERNAME=app_runtime.local
EXPECTED_SUPAVISOR_USERNAME=app_runtime.local
DATABASE_URL=postgres://app_runtime.local:replace_me@127.0.0.1:54329/postgres?sslmode=disable
DIRECT_DATABASE_URL=postgres://postgres:replace_me@localhost:54322/postgres

CLOUDFLARE_ACCESS_ISSUER=https://replace-me.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_me
CLOUDFLARE_ACCESS_JWKS_URL=https://replace-me.cloudflareaccess.com/cdn-cgi/access/certs
OWNER_EMAIL=owner@example.test
