{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "contractVersion": 4,
  "namespace": "release-smoke-v1",
  "rowId": "7355773e-c3b5-4e5d-9f07-55ac0e22f384",
  "objectPaths": [
    "release-smoke-v1/original.png",
    "release-smoke-v1/thumbnail.webp"
  ],
  "identityFormat": "release-smoke-v1:<40-char-lowercase-git-sha>",
  "generationFormat": "uuid-v4-created-once-per-complete-attempt",
  "actionSequenceFormat": "positive-integer-starting-at-1-incremented-on-every-next-action",
  "payloadHashInput": ["namespace", "identity", "rowId", "objectPaths"],
  "persistedPhases": [
    "row_claimed",
    "object_write_pending",
    "object_written",
    "object_write_uncertain",
    "cleanup_pending",
    "cleanup_uncertain"
  ],
  "bounds": {
    "baseline": { "row": 0, "object": 0 },
    "mutationMaximum": { "row": 1, "object": 2 },
    "cleanup": { "row": 0, "object": 0 }
  },
  "checks": [
    "custom-domain-owner-access",
    "direct-origin-denied",
    "authenticated-library-read",
    "runtime-database-read",
    "private-storage-direct-denied",
    "canary-row-round-trip",
    "canary-object-round-trip",
    "private-media-original-read",
    "media-thumbnail-generated",
    "private-media-thumbnail-read",
    "canary-cleanup-counts"
  ],
  "residuePolicy": {
    "automaticCleanup": [
      "same-generation exact 1/0 row_claimed residue",
      "same-generation byte-exact partial 1/1 removed inside definitive write failure handling",
      "same-generation exact 1/2 object_written residue"
    ],
    "stop": [
      "0/1-2 object-only residue",
      "any persisted partial 1/1 media residue",
      "different generation, identity, or payload hash",
      "object_write_uncertain or cleanup_uncertain"
    ]
  },
  "stateEvents": [
    "counts-observed",
    "fixed-read-checks-observed",
    "row-written",
    "object-written",
    "round-trip-observed",
    "private-storage-denial-observed",
    "cleanup-finished",
    "operation-failed",
    "operation-uncertain"
  ],
  "evidenceAllowlist": ["namespace", "executionSha", "generation", "identity", "payloadSha256", "counts", "checks", "requestIds"]
}
