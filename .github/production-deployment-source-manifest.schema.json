{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elekli/puizeru-gamebase/.github/production-deployment-source-manifest.schema.json",
  "title": "Production deployment source manifest",
  "type": "object",
  "additionalProperties": false,
  "x-maxCanonicalUtf8Bytes": 43200512,
  "required": ["schemaVersion", "commitSha", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "files": {
      "type": "array",
      "maxItems": 20000,
      "x-maxTotalBytes": 1073741824,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha1"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "x-maxUtf8Bytes": 1024
          },
          "size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
          "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    }
  }
}
