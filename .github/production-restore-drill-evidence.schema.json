{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://puizeru-gamebase.invalid/schemas/production-restore-drill-evidence.schema.json",
  "title": "Production restore drill evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "dumpByteLength",
    "dumpSha256",
    "integrityChecks",
    "targetCleaned",
    "dumpCleaned",
    "storageBinariesIncluded"
  ],
  "properties": {
    "outcome": { "const": "passed" },
    "dumpByteLength": { "type": "integer", "minimum": 1 },
    "dumpSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrityChecks": { "type": "integer", "minimum": 1 },
    "targetCleaned": { "const": true },
    "dumpCleaned": { "const": true },
    "storageBinariesIncluded": {
      "const": false,
      "description": "PostgreSQL dump and restore evidence excludes Supabase Storage object binaries."
    }
  }
}
