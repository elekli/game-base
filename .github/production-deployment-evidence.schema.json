{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elekli/game-base/blob/main/.github/production-deployment-evidence.schema.json",
  "title": "Sanitized production deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "repository", "workflowRunId", "workflowRunAttempt",
    "executionSha", "releaseIdentity", "sourceManifestSha256",
    "canaryContractVersion", "releaseKind", "migrationTail",
    "baselineDeploymentId", "stagedDeploymentId", "productionDomain",
    "startedAt", "completedAt", "outcome", "promotionAttempts",
    "rollbackOutcome", "rollbackAttempts", "smoke"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": { "const": "elekli/game-base" },
    "workflowRunId": { "type": "string", "pattern": "^[0-9]+$" },
    "workflowRunAttempt": { "type": "integer", "minimum": 1 },
    "executionSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "releaseIdentity": { "type": "string", "pattern": "^production:[a-f0-9]{40}$" },
    "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canaryContractVersion": { "const": 3 },
    "releaseKind": { "enum": ["code-only", "migration-bearing"] },
    "migrationTail": { "type": "string", "pattern": "^[0-9]{4,}$" },
    "baselineDeploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]+$" },
    "stagedDeploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]+$" },
    "productionDomain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["passed", "rolled-back"] },
    "promotionAttempts": { "type": "integer", "minimum": 1, "maximum": 2 },
    "rollbackOutcome": { "enum": ["not-required", "baseline-restored"] },
    "rollbackAttempts": { "type": "integer", "minimum": 0, "maximum": 2 },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "generation", "requestIds"],
      "properties": {
        "outcome": { "enum": ["passed", "failed"] },
        "generation": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "requestIds": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
        },
        "counts": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "baseline": { "$ref": "#/$defs/zeroCounts" },
            "mutation": { "$ref": "#/$defs/mutationCounts" },
            "cleanup": { "$ref": "#/$defs/zeroCounts" }
          }
        },
        "checks": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "custom-domain-owner-access": { "enum": ["passed", "failed"] },
            "direct-origin-denied": { "enum": ["passed", "failed"] },
            "authenticated-library-read": { "enum": ["passed", "failed"] },
            "runtime-database-read": { "enum": ["passed", "failed"] },
            "private-storage-direct-denied": { "enum": ["passed", "failed"] },
            "canary-row-round-trip": { "enum": ["passed", "failed"] },
            "canary-object-round-trip": { "enum": ["passed", "failed"] },
            "canary-cleanup-counts": { "enum": ["passed", "failed"] }
          }
        }
      }
    }
  },
  "$defs": {
    "zeroCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["row", "object"],
      "properties": { "row": { "const": 0 }, "object": { "const": 0 } }
    },
    "mutationCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["row", "object"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 1 },
        "object": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "rollbackOutcome": { "const": "not-required" },
          "rollbackAttempts": { "const": 0 },
          "smoke": {
            "required": ["counts", "checks"],
            "properties": {
              "outcome": { "const": "passed" },
              "counts": {
                "required": ["baseline", "mutation", "cleanup"],
                "properties": {
                  "mutation": {
                    "properties": {
                      "row": { "const": 1 },
                      "object": { "const": 1 }
                    }
                  }
                }
              },
              "checks": {
                "required": [
                  "custom-domain-owner-access", "direct-origin-denied",
                  "authenticated-library-read", "runtime-database-read",
                  "private-storage-direct-denied", "canary-row-round-trip",
                  "canary-object-round-trip", "canary-cleanup-counts"
                ],
                "properties": {
                  "custom-domain-owner-access": { "const": "passed" },
                  "direct-origin-denied": { "const": "passed" },
                  "authenticated-library-read": { "const": "passed" },
                  "runtime-database-read": { "const": "passed" },
                  "private-storage-direct-denied": { "const": "passed" },
                  "canary-row-round-trip": { "const": "passed" },
                  "canary-object-round-trip": { "const": "passed" },
                  "canary-cleanup-counts": { "const": "passed" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "rolled-back" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "rollbackOutcome": { "const": "baseline-restored" },
          "rollbackAttempts": { "minimum": 0 },
          "smoke": {
            "required": ["counts", "checks"],
            "properties": {
              "outcome": { "const": "failed" },
              "counts": {
                "required": ["cleanup"],
                "properties": {
                  "cleanup": { "$ref": "#/$defs/zeroCounts" }
                }
              },
              "checks": {
                "required": ["canary-cleanup-counts"],
                "properties": {
                  "canary-cleanup-counts": { "const": "passed" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
