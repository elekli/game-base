{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elekli/game-base/blob/main/.github/production-deployment-evidence.schema.json",
  "title": "Sanitized production deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "workflowRunId",
    "workflowRunAttempt",
    "executionSha",
    "releaseKind",
    "migrationTail",
    "baselineDeploymentId",
    "stagedDeploymentId",
    "productionDomain",
    "startedAt",
    "completedAt",
    "outcome",
    "promotionAttempts",
    "rollbackOutcome",
    "rollbackAttempts",
    "smoke"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "elekli/game-base" },
    "workflowRunId": { "type": "string", "pattern": "^[0-9]+$" },
    "workflowRunAttempt": { "type": "integer", "minimum": 1 },
    "executionSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "releaseKind": {
      "enum": ["code-only", "migration-bearing"]
    },
    "migrationTail": { "type": "string", "pattern": "^[0-9]{4,}$" },
    "baselineDeploymentId": {
      "type": "string",
      "pattern": "^dpl_[A-Za-z0-9]+$"
    },
    "stagedDeploymentId": {
      "type": "string",
      "pattern": "^dpl_[A-Za-z0-9]+$"
    },
    "productionDomain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["passed", "rolled-back"] },
    "promotionAttempts": { "type": "integer", "minimum": 1, "maximum": 2 },
    "rollbackOutcome": {
      "enum": ["not-required", "baseline-restored"]
    },
    "rollbackAttempts": { "type": "integer", "minimum": 0, "maximum": 2 },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "requestIds", "checks"],
      "properties": {
        "outcome": { "enum": ["passed", "failed"] },
        "requestIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "outcome"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "outcome": { "enum": ["passed", "failed"] }
            }
          }
        }
      }
    }
  }
}
